        "lines": [
          "export function decide(refund: Refund) {",
          "  const limit = settings.autoRefundLimit;",
          "  if (refund.amount <= limit) {",
          "    return approve(refund);",
          "  }",
          "  return askManager(refund);",
          "}"
        ],
